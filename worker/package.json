{
  "name": "@newsletter/worker",
  "version": "0.1.2",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:jsdom --external:node-appwrite --external:feedsmith --external:turndown --external:@mozilla/readability --target=es2022 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity-run": "tsx --env-file=.env src/parity-run.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@newsletter/shared": "workspace:*",
    "feedsmith": "^2.9",
    "jsdom": "^25.0.1",
    "node-appwrite": "^26.2.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
