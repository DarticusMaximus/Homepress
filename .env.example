# Homepress — environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# The real .env is gitignored; this file is the committed template (never put
# live secrets here).
#
# All keys below are runtime container/process env. Prebuilt GHCR images read
# them at start — you do not rebuild when changing Appwrite endpoint/project.

# ---- Appwrite (required) ----
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=
APPWRITE_API_KEY=

# ---- Operator bootstrap (required before first factory login) ----
# Email of the household operator. Read only by `pnpm run bootstrap:operator`
# (web/worker do not use this key at runtime). The script labels an existing
# Appwrite user with this email, or creates one and prints a generated
# password once. Without this bootstrap, nobody can reach the factory.
HOMEPRESS_OPERATOR_EMAIL=

# ---- OpenRouter (required) ----
# GUI Settings override when set; blank GUI falls back to this env then none.
OPENROUTER_API_KEY=

# ---- Cross-run deduplication ----
# Cosine similarity (0–1) for cross-run topic suppress (title+tags).
# Candidates at or above this value are hard-dropped before MMR. Default 0.85.
# Higher = stricter (more suppressions). Lower = looser. Unset/invalid → 0.85.
# GUI Settings override when set; blank GUI falls back to env then 0.85.
CROSS_RUN_SIMILARITY_THRESHOLD=0.85

# ---- Optional curation / drafter knobs (GUI → env → code default) ----
# GUI Settings override these when set; blank GUI falls back to env then code default.
# SCORE_THRESHOLD=7.0
# RSS_FEED_MAX_ITEMS=10
# DRAFTER_REASONING_EFFORT=high
# DRAFTER_MAX_COMPLETION_TOKENS=32000

# ---- Optional model overrides (defaults live in shared/src/pipeline/config.ts) ----
# TAGGER_MODEL=
# SCORER_MODEL=
# DRAFTER_MODEL=
# TITLE_DEK_MODEL=
# EMBED_MODEL=

# ---- Optional worker poll / heartbeat knobs (ms; defaults in worker) ----
# WORKER_HEARTBEAT_MS=30000
# WORKER_RUN_POLL_MS=3000
# WORKER_SCHEDULE_POLL_MS=60000
# WORKER_RETENTION_POLL_MS=86400000
# WORKER_STALE_RUN_MS=300000

# ---- Optional scraper knobs ----
# SCRAPER_TIMEOUT_MS=
# SCRAPER_MIN_EXTRACTED_LENGTH=

# ---- Optional container timezone (IANA name, e.g. America/New_York) ----
# TZ=

# ---- Public app URL (RSS absolute links + Delivery feed URL) ----
# Public origin of this web app, no trailing slash. Required for RSS absolute
# <link> values and the copyable feed URL in newsletter edit Delivery.
# Example: https://news.example.com
# Never invent a host in app logic — leave blank until you set the real origin.
# GUI Settings override when set; blank GUI falls back to this env then none.
APP_PUBLIC_URL=

# ---- Web port binding (compose web service) ----
# compose.yaml maps the web port as "${WEB_BIND_ADDR:-127.0.0.1}:3000:3000"
# and reads this key from the root .env automatically. Commented because
# loopback (127.0.0.1) IS the default — set WEB_BIND_ADDR only when something
# outside the host must reach :3000 directly (reverse proxy in another
# container/host, direct LAN access); use 0.0.0.0 or a specific interface IP.
# NEVER set it empty: the :- interpolation treats set-but-empty as unset and
# silently falls back to loopback, silently ignoring the override intent.
# WEB_BIND_ADDR=0.0.0.0

# ---- Settings secret encryption (optional, recommended) ----
# AES-256-GCM key that encrypts GUI-stored OpenRouter API key and SMTP
# password at rest in app_settings. Exactly 64 hex characters (32 bytes).
# Generate with:
#   openssl rand -hex 32
# SETTINGS_SECRET_KEY=
# Unset: secrets still save as plaintext and Settings shows a warning.
# Invalid (set but not 64 hex): secret writes are refused until the key is fixed.
# Rotating or losing this key makes already-encrypted stored secrets
# unreadable until you re-enter them in Settings (resolution falls back
# to OPENROUTER_API_KEY / SMTP_PASSWORD env). Web and worker must share
# the same value — one .env, both containers' env_file.

# ---- SMTP (manual issue email send from Issues UI) ----
# GUI Settings override the full SMTP bundle when set; blank GUI falls back to env.
# Hostname (required to send)
SMTP_HOST=
# Integer port e.g. 587 or 465
SMTP_PORT=
# Auth user
SMTP_USERNAME=
# Auth password
SMTP_PASSWORD=
# Optional From header; blank → use SMTP_USERNAME
SMTP_FROM=
# Optional; true/1/yes → implicit TLS (typical 465); else STARTTLS (typical 587)
SMTP_SECURE=
